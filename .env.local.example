# ==== BALA rezervacijų sistema ====
# Nukopijuokite šį failą į .env.local ir įrašykite realias reikšmes.
# .env.local NIEKADA nekelkite į GitHub (jis jau ignoruojamas).

# --- Svetainės adresas (be pabaigos brūkšnio) ---
# Lokaliai: http://localhost:3000 ; produkcijoje: https://jusu-domenas.lt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Settings -> API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role raktas (SLAPTAS!)

# --- Paysera „Checkout Modern" (OAuth2) ---
# Projekto Integrations -> API credentials: Client ID + Client Secret.
PAYSERA_CLIENT_ID=
PAYSERA_CLIENT_SECRET=
# Paysera projekto nustatymuose nurodykite Callback URL:
#   https://JUSU-DOMENAS/api/paysera/callback

# --- Testavimas be mokėjimo (lokaliai) ---
# 1 = rezervacija/kuponas sukuriami BE mokėjimo (iškart "paid"/"active").
# Naudokite TIK lokaliai. Produkcijoje NENUSTATYKITE — kitaip pirktų nemokamai.
BOOKING_TEST_MODE=

# --- Admin skydelis (/admin) ---
# Slaptažodis prisijungimui prie rezervacijų valdymo.
# Jei nenustatyta IR nėra Supabase — veikia DEMO režimas (slaptažodis "demo").
# Jei yra Supabase, bet nenustatytas — /admin bus UŽRAKINTA (saugumui).
ADMIN_PASSWORD=

# --- Google Calendar (verslo kalendoriaus auto-sync) ---
# Apmokėta rezervacija automatiškai tampa įvykiu Jūsų Google kalendoriuje.
# Jei šie 3 kintamieji tušti — integracija tiesiog neveikia (rezervacijos vis tiek veikia).
# Nustatymas: Google Cloud -> service account -> JSON raktas; kalendorių pasidalinkite su
# service account el. paštu suteikdami teisę „Keisti įvykius" (žr. REZERVACIJA_SETUP.md).
GOOGLE_CALENDAR_ID=                 # kalendoriaus ID (Settings -> Integrate calendar -> Calendar ID)
GOOGLE_SA_EMAIL=                    # service account el. paštas (...@...iam.gserviceaccount.com)
GOOGLE_SA_PRIVATE_KEY=              # PEM raktas vienoje eilutėje su \n (pvz. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")

# --- El. laiškų patvirtinimai (Gmail SMTP) ---
# Apmokėjus rezervaciją siunčiamas patvirtinimas klientui ir pranešimas adminui.
# Jei tušti — laiškai nesiunčiami (rezervacijos vis tiek veikia).
# Reikia: Google paskyroje įjungti 2FA -> susikurti „App Password" (Slaptažodžiai programoms).
GMAIL_USER=                        # siuntėjo Gmail, pvz. bala.pramogos@gmail.com
GMAIL_APP_PASSWORD=                # 16 simbolių App Password (tarpai nesvarbu)
ADMIN_NOTIFY_EMAIL=                # kur siųsti pranešimus adminui (tuščia = tas pats kaip GMAIL_USER)
